#!/usr/bin/env php
<?php
declare(strict_types=1);

use Common\Cli\HealthCheck;
use Common\Cli\Shutdownable;

chdir(__DIR__ . '/../../../..');

require 'vendor/autoload.php';

$container = require 'config/container.php';
$config    = include 'config/config.php';

$command = $argv[1] ?? null;

if (!$command)
{
	echo "Missing command as first argument" . PHP_EOL;
	exit(1);
}

if ($command === 'clear-config-cache')
{
	if (!isset($config['config_cache_path']))
	{
		echo "No configuration cache path found" . PHP_EOL;
		exit(0);
	}

	if (!file_exists($config['config_cache_path']))
	{
		printf(
			"Configured config cache file '%s' not found%s",
			$config['config_cache_path'],
			PHP_EOL
		);
		exit(0);
	}

	if (false === unlink($config['config_cache_path']))
	{
		printf(
			"Error removing config cache file '%s'%s",
			$config['config_cache_path'],
			PHP_EOL
		);
		exit(1);
	}

	printf(
		"Removed configured config cache file '%s'%s",
		$config['config_cache_path'],
		PHP_EOL
	);
	exit(0);
}

if ($command === 'shutdownable')
{
	$shutdownableConfig = $config['common']['shutdownable'];

	$startTime = time();

	while (true)
	{
		if ((time() - $startTime) >= $shutdownableConfig['timeout'])
		{
			break;
		}

		$shutdownable = true;

		foreach (($shutdownableConfig['checkers'] ?? []) as $checkerClass)
		{
			/**
			 * @var Shutdownable $checker
			 */
			$checker = $container->get($checkerClass);

			if (!$checker instanceof Shutdownable)
			{
				throw new Exception('Shutdownable checker class must implement Shutdownable');
			}

			if (!$checker->isShutdownable())
			{
				$shutdownable = false;
			}
		}

		if ($shutdownable)
		{
			exit(0);
		}

		sleep($shutdownableConfig['checkInterval']);
	}

	exit(1);
}

if ($command === 'health-check')
{
	$healthCheckExitCode = 0;

	foreach (($config['common']['health-check']['checkers'] ?? []) as $checkerClass)
	{
		/**
		 * @var HealthCheck $checker
		 */
		$checker = $container->get($checkerClass);

		if (!$checker instanceof HealthCheck)
		{
			throw new Exception('Health check checker class must implement HealthCheck');
		}

		if (!$checker->isHealthy())
		{
			$healthCheckExitCode = 1;
			break;
		}
	}

	exit($healthCheckExitCode);
}

printf(
	"Invalid command '%s' given%s",
	$command,
	PHP_EOL
);
exit(1);