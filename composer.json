	"bin": [
		"bin/mezzio-doctrine",
		"bin/mezzio-common"
	],
	"require": {
		"php": "~8.4.0 || ~8.5.0",
		"ext-json": "*",
		"laminas/laminas-servicemanager": "^3.23.0",
		"nesbot/carbon": "^3.13.0",
		"psr/http-message": "^1.0 || ^2.0",
		"laminas/laminas-diactoros": "^3.8.0",
		"psr/http-server-handler": "^1.0.0",
		"mezzio/mezzio-laminasrouter": "^3.12.0",
		"laminas/laminas-validator": "^2.65.0",
		"laminas/laminas-translator": "^1.3.0",
		"laminas/laminas-i18n": "^2.33.0",
		"umpirsky/country-list": "^2.0.0",
		"roave/psr-container-doctrine": "^6.2.0",
		"mezzio/mezzio-helpers": "^5.20.0",
		"laminas/laminas-filter": "^2.42.0",
		"laminas/laminas-view": "^2.44.0",
		"symfony/cache": "^8.1.0"
	},
	"suggest": {
		"ext-iconv": "*",
		"ext-openssl": "*",
		"ext-calendar": "*"
	},
	"autoload": {
		"psr-4": {
			"Common\\": "src/",
			"CommonTest\\": "test/src/"
		}
	},
	"require-dev": {
		"leuchtdiode/mezzio-testing": "^1.1.0"
